# Copy this file to .env to configure the app.
# Demo mode uses an in-memory store and is intended only for local development.
DATA_MODE=demo
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PLATFORM_COMMISSION_RATE=0.10

# For Firebase, set DATA_MODE=firebase and provide Firebase Admin credentials.
# Use Application Default Credentials or point GOOGLE_APPLICATION_CREDENTIALS
# to a service-account JSON file stored outside the repository.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Web Push support. Generate VAPID keys with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
